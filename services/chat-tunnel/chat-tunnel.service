[Unit]
Description=chat-tunnel: single owner of /tmp/leo.log (tail -> SQLite, correlated sends)
After=network-online.target
# restart with the stack: `systemctl --user restart leo-director`
# pulls this service too (the code it serves ships in the same repo)
PartOf=leo-director.service

[Service]
WorkingDirectory=%h/downloads/director-drop
ExecStart=/bin/bash -c 'cd %h/downloads/director-drop && exec python3 -u services/chat-tunnel/chat_tunnel.py >> services/chat-tunnel/tunnel.log 2>&1'
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
