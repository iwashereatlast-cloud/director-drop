[Unit]
Description=Leo db-search service (read-only query catalog, service 2/4)
After=network-online.target
# restart with the stack: `systemctl --user restart leo-director`
# pulls this service too (the code it serves ships in the same repo)
PartOf=leo-director.service

[Service]
WorkingDirectory=%h/downloads/director-drop
ExecStart=/bin/bash -c 'cd %h/downloads/director-drop/services/db-search && exec python3 -u dbsearch.py serve >> dbsearch.log 2>&1'
Environment=DBSEARCH_ADAPTER=mysql
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
