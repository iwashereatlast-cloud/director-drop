[Unit]
Description=director-drop web-gui (read-only dashboard over chat-tunnel/db-search/rtt-engine)
After=network.target chat-tunnel.service db-search.service rtt-engine.service

[Service]
Type=simple
WorkingDirectory=%h/downloads/director-drop
ExecStart=/usr/bin/python3 %h/downloads/director-drop/services/web-gui/web_gui.py serve
Environment=WEBGUI_PORT=8766
Environment=WEBGUI_CENSUS=i_was_here
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
