#!/usr/bin/env bash
# botcmd - Chazbot server control: one front door for the whole stack.
# Everything it does is the same command you would have pasted by hand
# (systemctl --user, journalctl, mysql RO identity, FIFO printf, git pull),
# just remembered for you - with the G1 rules baked in structurally.
#
# install:  chmod +x this file, then
#           ln -s $HOME/downloads/director-drop/bin/botcmd $HOME/.local/bin/botcmd
#           (logout/login if ~/.local/bin is not already on PATH)
# usage:    botcmd                       interactive menu
#           botcmd <area> <action>       one-shot (botcmd help)
# update:   Director -> deploy (git pull) also updates botcmd itself.
set -u

BC_SELF=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null) || BC_SELF="${BASH_SOURCE[0]}"
BC_LIB=$(dirname "$(dirname "$BC_SELF")")/lib/botcmd

. "$BC_LIB/common.sh"
. "$BC_LIB/leo.sh"
. "$BC_LIB/director.sh"
. "$BC_LIB/roster.sh"
. "$BC_LIB/states.sh"
. "$BC_LIB/watchdog.sh"
. "$BC_LIB/system.sh"
. "$BC_LIB/launch.sh"
. "$BC_LIB/master.sh"

usage() {
  cat <<'EOF'
botcmd - Chazbot control

  botcmd                              interactive menu
  botcmd status                       one-screen dashboard (units + census)
  botcmd launch                       full boot ritual (worldserver..timer)

  botcmd leo on|off|status            Leo shell (client presence)
  botcmd leo chat [N|-f]              last N lines, or live follow with -f
  botcmd director restart|status      LLM daemon
  botcmd director log [N]             last N lines of daemon.log
  botcmd director watch               live tail -f of daemon.log (Ctrl-C to stop)
  botcmd director raid [toon]         group/raid of a toon from the DB (default Leo: leader, members)
  botcmd director deploy              git pull + compile check + restart
  botcmd director commands            Leo's command list (parsed live)
  botcmd roster census                live who's-online (read-only DB)
  botcmd roster ritual                summon full roster (G1-safe)
  botcmd roster add <toon>            bring one bot online (hand-play refused)
  botcmd roster remove <toon>         stand one down (works on hand-play too)
  botcmd roster down <toon|all>       'bot remove' first (graceful for real bots); SOAP .kick only if still online - so the ritual can re-add them as bots
  botcmd roster fix                   kick all online watched bots -> ritual -> verify (one command)
  botcmd go <toon> <zone...>          walk one bot to a zone now (go travel; G1 refused)
  botcmd states show                  state layout: conf + online + live
  botcmd states apply [bot|all]       push conf states to online bots
  botcmd states edit                  edit ~/.botcmd-states.conf
  botcmd states presets               built-in strategy presets (+ zone recipes)
  botcmd states bots                  pick a bot (paginated) -> set its default state
  botcmd states zones [level]         vanilla level->zone table (for go travel)
  botcmd states setall [preset]       set EVERY alt bot (no arg = [x] picker) + apply online + verify (grind|quest|gather|follow|idle)
  botcmd states verify [bot|all]      Leo whispers 'rpg status' to online bots; tabulates conf vs live reply + live group/leader (shows why a bot may be silent: Leo not master / not in its group)
  botcmd watchdog status|journal|conf presence-policy watchdog
  botcmd watchdog procs               duplicate-process audit (daemons, leo shell, menu lock)
  botcmd system worldserver           ac-worldserver check
  botcmd system soap                  SOAP gate status + live test
  botcmd system arm                   write ~/.soap-director (hidden prompts)
  botcmd system cmd '<console cmd>'   run a worldserver console command via SOAP
  botcmd system grants                RO identity SHOW GRANTS
  botcmd master show                  master account table (which account is HUMAN)
  botcmd master set <account|#>       rotate master account (rewrites ~/.director.env + restarts daemon)

Config overrides: ~/.botcmd.conf (see lib/botcmd/common.sh header).
EOF
}

# ---- one-shot extras the menu maps differently ----
leo_chat_oneshot() {
  if [ "${1:-}" = "-f" ]; then
    tail -n 200 -f "$BOTCMD_SHELL_LOG"
  else
    leo_chat "${1:-40}"
  fi
}

overall_status() {
  hdr "Chazbot dashboard ($(date '+%a %Y-%m-%d %H:%M'))"
  printf '  worldserver (system): %s\n' "$(command -v systemctl >/dev/null 2>&1 && systemctl is-active ac-worldserver 2>/dev/null || echo unknown)"
  printf '  leo shell (user):     %s\n' "$(user_unit_state leo)"
  printf '  leo-director (user):  %s\n' "$(user_unit_state leo-director)"
  printf '  watchdog timer:       %s\n' "$(user_unit_state leo-watchdog.timer)"
  if [ -s "$BOTCMD_SOAP_CONF" ] && [ "$(wc -l < "$BOTCMD_SOAP_CONF")" -ge 3 ]; then
    printf '  SOAP gate:            armed (live .pinfo location queries)\n'
  else
    printf '  SOAP gate:            NOT armed (location falls back to DB; sender gate is DB-based)\n'
  fi
  printf '  master account:       %s\n' "$(_master_current)"
  printf '  hand-play:           %s - never summoned, never commanded\n' "$BOTCMD_HANDPLAY"
  echo
  roster_census || true
}

main_menu() {
  local c
  while :; do
    clear >/dev/null 2>&1 || :
    hdr "Chazbot control - $(date '+%a %H:%M')"
    cat <<'EOF'
 1. Leo        (game client shell: online / off / status / chat log)
 2. Director   (LLM daemon: restart / status / logs / deploy)
 3. Roster     (census / summon ritual / add / remove bots)
 4. States     (who does what: per-bot strategies / layout / apply)
 5. Watchdog   (presence policy: timer / journal / conf)
 6. System     (worldserver / SOAP gate / DB / console)
 7. Full launch (ordered boot ritual: everything up, one button)
 8. Dashboard  (all units + census at a glance)
 9. Master     (human account selector - rotate which account you play on)
 Q. Quit       (blank Enter = back in submenus; here it just redraws)
EOF
    printf '%s' "choice: "; IFS= read -r c
    case "$c" in
      1) leo_menu ;;
      2) director_menu ;;
      3) roster_menu ;;
      4) states_menu ;;
      5) watchdog_menu ;;
      6) system_menu ;;
      7) launch; printf '%s' "press Enter... "; IFS= read -r _x ;;
      8) overall_status; printf '%s' "press Enter... "; IFS= read -r _x ;;
      9) master_menu ;;
      ""|b|back) warn "Q quits - Enter is 'back' in submenus" ;;
      q|Q|0) exit 0 ;;
      *) warn "invalid choice" ;;
    esac
  done
}

# One interactive botcmd menu at a time. The lock is a kernel flock on
# ~/.botcmd.lock, so a killed menu never leaves a stale lock. One-shot
# commands (status, watch, roster census, ...) are deliberately NOT locked.
menu_lock() {
  local lock="$HOME/.botcmd.lock" pid
  exec 9>"$lock" 2>/dev/null || return 0
  if flock -n 9 2>/dev/null; then
    printf '%s\n' "$$" > "$lock.pid"
    return 0
  fi
  pid=$(cat "$lock.pid" 2>/dev/null)
  errmsg "another botcmd MENU is already running (pid ${pid:-?}, lock: $lock)"
  warn "one-shot commands are not locked and still work: botcmd status | botcmd director watch | botcmd roster census ..."
  exit 1
}
locked() { menu_lock; "$@"; }

case "${1:-}" in
  ""|menu) locked main_menu ;;
  help|-h|--help) usage ;;
  status) overall_status ;;
  launch) launch ;;
  leo)
    case "${2:-}" in
      on) leo_on ;;
      off) leo_off ;;
      status) leo_status ;;
      chat) leo_chat_oneshot "${3:-}" ;;
      *) usage; exit 1 ;;
    esac ;;
  director)
    case "${2:-}" in
      restart) director_restart ;;
      status) director_status ;;
      log) director_log "${3:-40}" ;;
      watch) tail -f "$BOTCMD_DIRECTOR_LOG" ;;
      raid) director_raid "${3:-}" ;;
      deploy) director_deploy ;;
      commands) director_commands ;;
      *) usage; exit 1 ;;
    esac ;;
  go)
    shift
    roster_go "$@" ;;
  roster)
    case "${2:-}" in
      census) roster_census ;;
      ritual) roster_ritual ;;
      add) roster_add "${3:-}" ;;
      remove) roster_remove "${3:-}" ;;
      down) roster_down "${3:-}" ;;
      fix) roster_fix ;;
      *) usage; exit 1 ;;
    esac ;;
  states)
    case "${2:-}" in
      show) states_show ;;
      bots) locked states_pick_and_set ;;
      zones) states_zones "${3:-}" ;;
      setall) states_setall "${3:-}" ;;
      verify) states_verify "${3:-all}" ;;
      apply) states_apply "${3:-all}" ;;
      edit) states_edit ;;
      presets) states_presets ;;
      *) usage; exit 1 ;;
    esac ;;
  watchdog)
    case "${2:-}" in
      status) watchdog_status ;;
      journal) watchdog_journal "${3:-20}" ;;
      conf) watchdog_conf_edit ;;
      procs) watchdog_procs ;;
      *) usage; exit 1 ;;
    esac ;;
  system)
    case "${2:-}" in
      worldserver) system_worldserver ;;
      soap) system_soap_status ;;
      arm) system_soap_arm ;;
      cmd) system_cmd "${3:-}" ;;
      grants) system_grants ;;
      *) usage; exit 1 ;;
    esac ;;
  master)
    case "${2:-}" in
      show|"") master_show ;;
      set) master_set "${3:-}" ;;
      menu) locked master_menu ;;
      *) usage; exit 1 ;;
    esac ;;
  *) usage; exit 1 ;;
esac
