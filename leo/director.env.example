# Leo director runtime environment - read by leo-director.service through its
# systemd drop-in (leo/leo-director.service.d/override.conf -> EnvironmentFile).
#
# Install once:
#   cp leo/director.env.example ~/.director.env && chmod 600 ~/.director.env
#   mkdir -p ~/.config/systemd/user/leo-director.service.d
#   cp leo/leo-director.service.d/override.conf ~/.config/systemd/user/leo-director.service.d/
#   systemctl --user daemon-reload && systemctl --user restart leo-director
#
# After that, rotate the master account with:  botcmd master set I_WAS_HERE5TH
# (rewrites the three DIRECTOR_MASTER/HUMANS/HANDPLAY lines below and restarts
# the daemon). Edit by hand only if you know what you are doing.

DIRECTOR_MASTER_ACCOUNT=I_WAS_HERE1ST
# DIRECTOR_HUMANS=Cecil,Rydia,Shadow,Vivi,Aeris,Aerith
# DIRECTOR_HANDPLAY=Cecil,Rydia,Shadow,Vivi,Aeris,Aerith
# DIRECTOR_CONFIRM=1        # 1 = orders held for whisper 'go' (default); 0 = auto-execute
# DIRECTOR_HANDPLAY default note: both Aeris/Aerith spellings are protected
# until verified in the DB:  SELECT name FROM acore_characters.characters WHERE name LIKE 'Aeri%';

# Leo's own toon name - used for group/raid lookups ("who is in MY raid"):
# DIRECTOR_LEO=Leo
