[Unit]
Description=chat-tunnel: single owner of /tmp/leo.log (tail -> SQLite, correlated sends)
After=network-online.target
# restart with the stack: `systemctl --user restart web-gui`
# pulls this service too (the code it serves ships in the same repo).
# PartOf anchor moved off leo-director (retired as the steering point,
# 2026-11-15): stopping/disabling the daemon used to drag this service
# down with it - a live outage on serverpc.
PartOf=web-gui.service

[Service]
WorkingDirectory=%h/downloads/director-drop
ExecStart=/bin/bash -c 'cd %h/downloads/director-drop && exec python3 -u services/chat-tunnel/chat_tunnel.py >> services/chat-tunnel/tunnel.log 2>&1'
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
