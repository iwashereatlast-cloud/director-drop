[Unit]
Description=Leo director daemon (LLM brain)
# the brain never starts before its hands: db-search (facts) and
# chat-tunnel (sends/replies) come up first, and a restart of the
# master restarts them too (they carry PartOf=leo-director.service)
Requires=db-search.service chat-tunnel.service
After=network-online.target db-search.service chat-tunnel.service

[Service]
WorkingDirectory=%h/downloads/director-drop
ExecStart=/bin/bash -c 'cd %h/downloads/director-drop && exec python3 -u director.py daemon >> daemon.log 2>&1'
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
